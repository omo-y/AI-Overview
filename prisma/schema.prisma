generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model DiagnosisHistory {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  inputPreview String
  sourceUrl    String?
  totalScore   Int
  summary      String

  // SaaS化する場合は、ここに userId と User リレーションを追加する。
}
